# Copy this file to .env and fill in values. Never commit .env.
# The backend reads these. The frontend must not.

# gemini = call Google Gemini (needs GEMINI_API_KEY)
# fake   = canned policy-cancellation pack (no cloud call; useful for UI/tests)
AI_QA_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
